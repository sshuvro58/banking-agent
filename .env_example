DB_USER=''
DB_PASSWORD=''
DB_HOST=''
DB_PORT=5432
DB_NAME=banking




# ── LLM Provider ─────────────────────────
# Switch provider: "openrouter" or "bedrock"
LLM_PROVIDER=openrouter

# OpenRouter (default)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=meta-llama/llama-4-scout:free
LLM_MAX_TOKENS=4096

# AWS Bedrock (uncomment when ready)
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# ── Free models to try ───────────────────
# LLM_MODEL=meta-llama/llama-4-scout:free        # good all-round
# LLM_MODEL=qwen/qwen3-235b-a22b:free            # strong reasoning
# LLM_MODEL=google/gemini-2.5-flash              # fast, cheap
# LLM_MODEL=anthropic/claude-sonnet-4             # best tool-use